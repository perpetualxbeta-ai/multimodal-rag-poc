# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
# Used by the default config for embeddings, figure captions and answers.
GEMINI_API_KEY=

# Only needed if you switch any model in config.yaml to an OpenAI model (e.g. llm.model: gpt-4o).
OPENAI_API_KEY=

# Optional overrides of config.yaml (prefix MMRAG_, nested keys joined by "__"):
# MMRAG_LLM__MODEL=ollama/llama3.2-vision
# MMRAG_LLM__API_BASE=http://localhost:11434
# MMRAG_RETRIEVAL__TOP_K=8
